# Copying is optional. `npm run m365:configure:dev` creates the ignored runtime
# file and writes EAI OAuth settings to the ignored owner-only user file.
TEAMSFX_ENV=dev
APP_NAME_SUFFIX=dev
AGENT_SCOPE=personal

# Microsoft Agents Toolkit writes generated app identifiers to env/.env.dev.
# EAI OAuth settings and secrets are written to env/.env.dev.user.
